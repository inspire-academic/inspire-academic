{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.inspireacademic.org/assets/schemas/lesson-content.v1.schema.json",
  "title": "Inspire Lesson Content Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lessonId", "subject", "title", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lessonId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subject": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "baseBlock": {
      "type": "object",
      "required": ["id", "type", "order", "learningGoal"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": {
          "enum": ["explanation", "worked-example", "question", "diagram", "assessment", "simulation"]
        },
        "order": { "type": "integer", "minimum": 1 },
        "learningGoal": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["Both", "Foundation", "Higher"] }
      }
    },
    "block": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "if": { "properties": { "type": { "const": "simulation" } } },
          "then": {
            "required": ["componentId", "inputs", "fallback", "accessibility"],
            "properties": {
              "componentId": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "inputs": { "type": "object" },
              "fallback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "content"],
                "properties": {
                  "kind": { "enum": ["text", "diagram", "static"] },
                  "content": { "type": "string", "minLength": 1 }
                }
              },
              "accessibility": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "description"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1 },
                  "keyboardInstructions": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
